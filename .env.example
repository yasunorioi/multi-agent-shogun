# shogun 環境変数テンプレート
# cp .env.example .env して必要に応じて編集

# === cmd_517 結晶化機構v2 (scripts/botsu/crystallize.py) ===
# 結晶化機構v2 — MD目次格納先。cmd完遂時に PJ別 {project}.md を生成/追記する。
# 【v2変更点】context/{project}.md ではなく agent-swarm/crystals/ 配下に統一(cmd_517 v2, commit 244b2af)
# default: /home/yasu/agent-swarm/crystals
SHOGUN_CRYSTALS_DIR=/home/yasu/agent-swarm/crystals

# 結晶化機構の kill switch。1 にすると crystallize_cmd() が即時 return し全操作をスキップ。
# 緊急停止・メンテナンス時に使用。通常は 0 のまま。
# default: 0
SHOGUN_CRYSTALS_DISABLE=0

# === agent-swarm 連携パラメータ (scripts/botsu/crystallize.py が参照) ===

# agent-swarm dat_server の HTTP エンドポイント。
# POST /bbs/test/bbs.cgi 経由で crystals 板にレス投稿する際に使用。
# Python直叩き(_swarm_post_python)が失敗した場合のHTTPフォールバック先でもある。
# default: http://localhost:8824
SWARM_DAT_URL=http://localhost:8824

# 結晶化スレを書き込む板名。thread_replies テーブルの board カラムに対応。
# cmd_XXX スレ(cmd完遂記録)と project_* スレ(構造ドキュメント)の両方が格納される。
# default: crystals
SWARM_BOARD=crystals

# Python直叩き時の sys.path に追加するパス (agent-swarm/server ディレクトリ)。
# scripts/botsu/crystallize.py が `from botsu.reply import ...` 等でインポートする際に参照。
# default: /home/yasu/agent-swarm/server
SWARM_SERVER_PATH=/home/yasu/agent-swarm/server

# agent-swarm の SQLite DB パス。冪等チェック(既存スレへの重複投稿防止)に使用。
# thread_replies テーブルを直接参照して既投稿の有無を確認する。
# default: /home/yasu/agent-swarm/data/swarm.db
SWARM_DB=/home/yasu/agent-swarm/data/swarm.db
