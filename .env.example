# shogun 環境変数テンプレート
# cp .env.example .env して必要に応じて編集

# === cmd_517 結晶化機構 (crystallize.py) ===
# MD目次の出力先 (PJ別 .md ファイルが置かれる)
SHOGUN_CRYSTALS_DIR=/home/yasu/agent-swarm/crystals
# 1で結晶化を全停止 (kill switch)
SHOGUN_CRYSTALS_DISABLE=0
# agent-swarm dat_server の URL
SWARM_DAT_URL=http://localhost:8824
# 結晶化スレを書き込む板名
SWARM_BOARD=crystals
# Python直叩き時の sys.path (agent-swarm/server)
SWARM_SERVER_PATH=/home/yasu/agent-swarm/server
# agent-swarm の SQLite DB パス (冪等チェック用)
SWARM_DB=/home/yasu/agent-swarm/data/swarm.db
